<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- REQUIRED, and easy to lose.
         Flutter's template puts this permission only in the debug and profile
         manifests, so a release APK ships with NO network access at all. The
         app still launches and renders, and every catalog fetch fails with
         "could not reach the store, check your connection and try again" —
         which looks exactly like the user having no connectivity. It belongs
         here, in main, because the app fetches catalog.json on every launch. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="Alex Store"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Opens the app from a storefront link, e.g. a product page shared
                 from the website. `launchMode="singleTop"` above matters: a link
                 tapped while the app is already running arrives here via
                 onNewIntent instead of starting a second copy of the screen.

                 autoVerify makes the link VERIFIED, which skips the "Open with"
                 chooser entirely. That is not switched on yet — it needs
                 https://shahzadp.github.io/.well-known/assetlinks.json, which
                 cannot be served from a GitHub Pages project repo. Until then
                 Android still offers the app in the chooser. See
                 lib/src/services/deep_link_service.dart. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="shahzadp.github.io"/>
                <data android:pathPrefix="/store"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin.

         The two VIEW entries below are for the WhatsApp button, and they are
         the fix for a bug that was invisible on one handset and broke the
         button on another: on Android 11+ (API 30), `Intent.resolveActivity`
         only sees packages this app declares, so `canLaunchUrl` answered FALSE
         for a plain https:// link and the shopper was told no app could open
         the link, on a phone with both WhatsApp and a browser installed.

         `lib/src/services/launcher.dart` no longer gates the launch on
         `canLaunchUrl`, so the button works either way; this declaration is
         what makes the platform's *answers* about these schemes truthful.
         A redundant declaration is cheap; a silently wrong answer is not.
         `scripts/verify-release-apk.mjs` checks both entries survive into the
         packaged APK. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The universal link, opened in a browser when WhatsApp is absent. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- `whatsapp://send`, which opens the app itself. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="whatsapp"/>
        </intent>
    </queries>
</manifest>
