<?xml version="1.0" encoding="utf-8"?>
<!--
  Intentionally blank. This is the Android 12 system splash's icon.

  Left to itself, `android:windowSplashScreenAnimatedIcon` is the app's launcher
  icon — the shop's mark, centred and motionless, for the whole cold start.
  A silent gradient is faster and calmer.

  Referenced from res/values-v31/styles.xml and res/values-night-v31/styles.xml.
  Both must keep pointing here: the system splash is the only pre-Flutter
  surface the app has, and the last thing it needs is the mark pinned in the
  middle of it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
