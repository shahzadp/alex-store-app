<!--
  The launch backdrop.

  These are the three stops of the launch gradient, taken from
  Remotion/src/compositions/AlexStore/AlexStore.tsx:

      radial-gradient(1200px 1600px at 50% 40%,
                      #f5f3ff 0%, #fdf2f8 45%, #ecfeff 100%)

  The Android window is shown for the first few hundred milliseconds of a cold
  start, before Flutter has drawn anything. It is a deliberate surface rather
  than a white flash (or, in dark mode, a black one) — and the Android 12
  system splash paints the same top stop over it.
-->
<resources>
    <color name="splash_top">#F5F3FF</color>
    <color name="splash_mid">#FDF2F8</color>
    <color name="splash_bottom">#ECFEFF</color>
</resources>
