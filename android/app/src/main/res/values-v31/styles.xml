<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12 (API 31) replaced the windowBackground splash with a system
      splash: an icon, centred, on a solid colour. It does not read
      launch_background, so without the attributes below it picks its own
      colour — white in light mode, and in dark mode black, which would be a
      dark flash before the shop paints.

      windowSplashScreenBackground is the top stop of the launch gradient; the
      same value the window behind Flutter uses, so the hand-off is invisible.

      windowSplashScreenAnimatedIcon is the shop's monogram (the same glyph the
      launcher icon carries, without the white tile behind it), so the cold
      start is: gradient with the mark, then the shop. One mark, no video,
      nothing repetitive.

      Only LaunchTheme is restated here. Resource qualifying is per-style, so
      this file replaces LaunchTheme for API 31+ while NormalTheme still
      resolves from values/ — or from values-night/ in dark mode, because night
      mode outranks platform version in Android's resource selection. That is
      exactly why values-night-v31/styles.xml exists as well.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/splash_top</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
