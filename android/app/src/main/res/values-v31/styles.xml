<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12 (API 31) replaced the windowBackground splash with a system
      splash: the app icon, centred, on a solid colour. It does not read
      launch_background, so without the two attributes below it picks its own
      colour — white in light mode, and in dark mode black, which would be a
      black flash in front of a light video.

      windowSplashScreenBackground is the top stop of the video's gradient: the
      same value the launch window was already using, so the system splash and
      the window behind Flutter are the same colour and the changeover is not
      visible. The animated icon is stated explicitly as the app's own mark,
      because suppressing it would leave an empty screen and letting the
      framework choose risks its generic placeholder.

      Only LaunchTheme is restated here. Resource qualifying is per-style, so
      this file replaces LaunchTheme for API 31+ while NormalTheme still
      resolves from values/ — or from values-night/ in dark mode, because night
      mode outranks platform version in Android's resource selection. That is
      exactly why values-night-v31/styles.xml exists as well.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/splash_top</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
